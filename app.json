{
  "expo": {
    "name": "School Management",
    "slug": "school-management",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.schoolmanagement.app"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow School Management to select student photos."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "School Management"
    }
  }
}
